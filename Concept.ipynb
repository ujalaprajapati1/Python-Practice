      "a =  5\n",
      "b =  6\n"
     ]
    }
   ],
   "source": [
    "a = 6\n",
    "b = 5\n",
    "a, b = b, a\n",
    "print(\"a = \",a)\n",
    "print(\"b = \",b)"
